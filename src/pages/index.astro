---
import { Image } from 'astro:assets';
import {
  ArrowRight, BadgeCheck, BellRing, CheckCircle2, Clock3, Droplets, MessageCircle, Phone, ShieldCheck, Sparkles, Star,
} from 'lucide-react';
import Base from '@/layouts/Base.astro';
import Wave from '@/components/Wave.astro';
import ProductCard from '@/components/ProductCard.astro';
import { BRANDS, FEATURED, PRODUCTS } from '@/data/products';
import { SERVICES } from '@/data/services';
import { SITE, telHref, waHref } from '@/data/site';
import heroImage from '@/assets/products/blueshell-dolphin-plus.jpg';
import sideImage from '@/assets/products/nile-aqua-nine-n902.jpg';

const featured = FEATURED.map((id) => PRODUCTS.find((p) => p.id === id)!);
const homeServices = SERVICES.slice(0, 4);
const dueDate = (() => {
  const d = new Date(); d.setDate(d.getDate() + 7);
  return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
})();
---
<Base
  title="Green Wings Aqua — Water Purifier Sales & Service, Sivaganga"
  description="Green Wings Aqua Sales and Service — RO/UV water purifier sales, installation, repair and AMC plans in Sivaganga, Tamil Nadu. Call or WhatsApp for same-day service.">

  <!-- ------------------------------------------------------------ hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-aqua-50 pt-28 sm:pt-36">
    <div class="pointer-events-none absolute -left-32 top-0 size-[28rem] rounded-full bg-aqua-200/60 blur-3xl animate-blob"></div>
    <div class="pointer-events-none absolute -right-24 top-40 size-[30rem] rounded-full bg-brand-200/60 blur-3xl animate-blob [animation-delay:-7s]"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,var(--color-brand-200)_1px,transparent_0)] [background-size:28px_28px] opacity-40 [mask-image:radial-gradient(ellipse_at_center,black,transparent_70%)]"></div>

    <div class="container-x relative grid items-center gap-14 pb-10 lg:grid-cols-[1.1fr_1fr] lg:pb-20">
      <div>
        <span class="eyebrow" data-reveal><Droplets className="size-3.5" />Trusted local purifier experts</span>
        <h1 class="mt-6 text-[2.6rem] font-extrabold leading-[1.05] sm:text-6xl" data-reveal style="--delay:80ms">
          Pure water, reliable service — right here in <span class="text-gradient">Sivaganga</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600" data-reveal style="--delay:160ms">
          Green Wings Aqua handles sales, installation, repair and AMC for your home and office water purifiers —
          with quick response and genuine spare parts.
        </p>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--delay:240ms">
          <a href={waHref("Hi, I'd like to book a purifier service")} target="_blank" rel="noopener" class="btn-whatsapp">
            <MessageCircle className="size-5" />Book service on WhatsApp
          </a>
          <a href={telHref} class="btn-primary"><Phone className="size-5" />Call {SITE.call.display}</a>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-ink-600" data-reveal style="--delay:320ms">
          <span class="flex items-center gap-2">
            <span class="flex text-amber-400">{[0, 1, 2, 3, 4].map(() => <Star className="size-4 fill-current" />)}</span>
            <span><b class="text-ink-900">{SITE.rating.value}</b> from {SITE.rating.count} Google reviews</span>
          </span>
          <span class="flex items-center gap-1.5"><Clock3 className="size-4 text-brand-500" />Same-day service</span>
          <span class="flex items-center gap-1.5"><ShieldCheck className="size-4 text-brand-500" />Genuine parts</span>
        </div>
      </div>

      <!-- Product showcase with floating detail cards -->
      <div class="relative mx-auto w-full max-w-md lg:max-w-none" data-reveal style="--delay:200ms">
        <div class="absolute inset-6 rounded-[3rem] bg-gradient-to-br from-brand-500 to-aqua-400 opacity-90 blur-2xl"></div>
        <div class="glass relative overflow-hidden rounded-[2.5rem] p-6">
          <div class="rounded-[2rem] bg-gradient-to-br from-white to-brand-50 p-4">
            <Image src={heroImage} alt="Blueshell Dolphin+ smart RO water purifier" widths={[400, 640, 800]}
              sizes="(min-width: 1024px) 460px, 90vw" class="mx-auto aspect-square w-full object-contain animate-float" loading="eager" />
          </div>
        </div>

        <div class="glass absolute -left-4 top-10 hidden items-center gap-3 rounded-2xl px-4 py-3 sm:flex animate-float-slow">
          <span class="grid size-10 place-items-center rounded-xl bg-emerald-100 text-emerald-600"><CheckCircle2 className="size-5" /></span>
          <div class="text-sm leading-tight"><b class="text-ink-900">Same-day</b><div class="text-ink-500">service visits</div></div>
        </div>

        <div class="glass absolute -right-3 top-1/3 hidden w-44 overflow-hidden rounded-2xl p-2 sm:block animate-float [animation-delay:-3s]">
          <Image src={sideImage} alt="Nile Aqua Nine black gold finish" widths={[200, 320]} sizes="176px" class="aspect-square w-full rounded-xl bg-white object-contain" loading="eager" />
          <div class="px-1.5 pb-1 pt-2 text-xs"><b class="text-ink-900">Nile Aqua Nine</b><div class="text-ink-500">4 designer finishes</div></div>
        </div>

        <div class="glass absolute -bottom-4 left-6 right-10 flex items-start gap-3 rounded-2xl p-3.5 sm:left-10 sm:right-16 animate-float-slow [animation-delay:-4s]">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-whatsapp text-white"><BellRing className="size-4" /></span>
          <div class="text-[13px] leading-snug">
            <b class="text-ink-900">Service reminder</b>
            <p class="text-ink-600">Your water purifier service is due on {dueDate}. When may we visit?</p>
          </div>
        </div>
      </div>
    </div>
    <Wave class="relative h-12 text-white sm:h-20" />
  </section>

  <!-- ---------------------------------------------------------- brands -->
  <section class="py-10" aria-label="Brands we sell and service">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-ink-500">Brands we sell &amp; service</p>
    <div class="relative mt-6 overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_12%,black_88%,transparent)]">
      <div class="flex w-max animate-marquee gap-4 hover:[animation-play-state:paused]">
        {[...BRANDS, ...BRANDS].map((b) => (
          <span class="whitespace-nowrap rounded-full border border-slate-200 bg-white px-5 py-2.5 font-display text-sm font-semibold text-ink-600">{b}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ----------------------------------------------------------- stats -->
  <section class="container-x">
    <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-700 via-brand-600 to-aqua-500 px-6 py-10 text-white sm:px-12" data-reveal>
      <div class="pointer-events-none absolute -right-16 -top-16 size-64 rounded-full bg-white/10 blur-2xl"></div>
      <h2 class="text-center text-2xl font-bold !text-white sm:text-3xl">A local team you can count on</h2>
      <dl class="relative mt-8 grid grid-cols-2 gap-6 text-center lg:grid-cols-4">
        {[
          [`${SITE.rating.value}★`, 'Google rating'],
          [`${SITE.rating.count}+`, 'Customer reviews'],
          ['100%', 'Genuine parts'],
          ['Same-day', 'Service response'],
        ].map(([n, l], i) => (
          <div data-reveal style={`--delay:${i * 80}ms`}>
            <dt class="font-display text-3xl font-extrabold sm:text-4xl">{n}</dt>
            <dd class="mt-1 text-sm text-brand-100">{l}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- -------------------------------------------------------- services -->
  <section class="container-x pt-24">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow" data-reveal><Sparkles className="size-3.5" />Our services</span>
      <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl" data-reveal>Everything your purifier needs, in one place</h2>
      <p class="mt-3 text-ink-600" data-reveal>From a brand-new installation to a routine filter change — we've got it covered.</p>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {homeServices.map((s, i) => (
        <div class="card" data-reveal style={`--delay:${i * 80}ms`}>
          <span class="icon-tile"><s.icon className="size-6" /></span>
          <h3 class="mt-5 text-lg font-bold">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{s.short}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 text-center"><a href="/services.html" class="btn-ghost">See all services<ArrowRight className="size-4" /></a></div>
  </section>

  <!-- -------------------------------------------------------- products -->
  <section class="relative mt-24 bg-gradient-to-b from-white via-brand-50/50 to-white py-20">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-xl">
          <span class="eyebrow" data-reveal><BadgeCheck className="size-3.5" />Our products</span>
          <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl" data-reveal>Trusted brands, wide range</h2>
          <p class="mt-3 text-ink-600" data-reveal>We sell and service RO, UV and UF purifiers from leading brands — see our full catalog.</p>
        </div>
        <a href="/products.html" class="btn-ghost" data-reveal>View all {PRODUCTS.length} products<ArrowRight className="size-4" /></a>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((p, i) => <ProductCard product={p} delay={i * 80} />)}
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------- reminders -->
  <section class="container-x pt-16">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow" data-reveal><BellRing className="size-3.5" />Never miss a service</span>
        <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl" data-reveal>We remind you before your AMC is due</h2>
        <p class="mt-4 text-lg text-ink-600" data-reveal>
          Green Wings Aqua tracks your purifier's service date and sends a reminder on WhatsApp (with SMS backup) —
          so your filters stay fresh and your warranty stays valid.
        </p>
        <ul class="mt-6 grid gap-3" data-reveal>
          {['Service dates tracked for every customer', 'A WhatsApp message before each due date', 'Book the visit with a single reply'].map((t) => (
            <li class="flex items-center gap-3 text-ink-800"><CheckCircle2 className="size-5 text-brand-500" />{t}</li>
          ))}
        </ul>
        <a href="/amc.html" class="btn-primary mt-8" data-reveal>Explore AMC plans<ArrowRight className="size-4" /></a>
      </div>

      <!-- A phone showing the reminder exactly as the customer receives it -->
      <div class="relative mx-auto w-full max-w-xs" data-reveal style="--delay:120ms">
        <div class="absolute -inset-8 rounded-full bg-gradient-to-br from-aqua-200 to-brand-200 opacity-70 blur-3xl"></div>
        <div class="relative rounded-[2.75rem] border-[10px] border-ink-900 bg-[#efe7dd] shadow-2xl">
          <div class="flex items-center gap-3 rounded-t-[2rem] bg-[#075e54] px-4 pb-3 pt-5 text-white">
            <img src="/assets/icon-192.png" alt="" class="size-9 rounded-full bg-white" />
            <div class="leading-tight"><div class="text-sm font-semibold">Green Wings Aqua</div><div class="text-[11px] opacity-80">online</div></div>
          </div>
          <div class="grid gap-3 p-4 pb-10 text-[13px]">
            <div class="max-w-[85%] rounded-xl rounded-tl-none bg-white p-3 shadow-sm">
              Hello, Green Wings Aqua. Your water purifier service is due on <b>{dueDate}</b>. When may we visit?
              <div class="mt-1 text-right text-[10px] text-slate-400">10:02 am</div>
            </div>
            <div class="ml-auto max-w-[80%] rounded-xl rounded-tr-none bg-[#d9fdd3] p-3 shadow-sm">
              Saturday morning is fine 👍
              <div class="mt-1 text-right text-[10px] text-slate-400">10:05 am ✓✓</div>
            </div>
            <div class="max-w-[85%] rounded-xl rounded-tl-none bg-white p-3 shadow-sm">
              Booked! Our technician will visit on Saturday. 🙏
              <div class="mt-1 text-right text-[10px] text-slate-400">10:06 am</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- cta -->
  <section class="container-x pt-24">
    <div class="relative overflow-hidden rounded-[2rem] bg-ink-900 px-6 py-14 text-center sm:px-12" data-reveal>
      <div class="pointer-events-none absolute -left-20 -top-20 size-72 rounded-full bg-brand-500/40 blur-3xl animate-blob"></div>
      <div class="pointer-events-none absolute -bottom-24 -right-10 size-72 rounded-full bg-aqua-400/30 blur-3xl animate-blob [animation-delay:-5s]"></div>
      <h2 class="relative text-3xl font-extrabold !text-white sm:text-4xl">Ready for cleaner, safer water?</h2>
      <p class="relative mx-auto mt-3 max-w-xl text-slate-300">
        Message us on WhatsApp or call directly — our team typically responds within minutes during business hours.
      </p>
      <div class="relative mt-8 flex flex-wrap justify-center gap-3">
        <a href={waHref("Hi, I'd like to enquire about a water purifier")} target="_blank" rel="noopener" class="btn-whatsapp"><MessageCircle className="size-5" />Chat on WhatsApp</a>
        <a href="/contact.html" class="btn-light">Send an enquiry<ArrowRight className="size-4" /></a>
      </div>
    </div>
  </section>
</Base>
