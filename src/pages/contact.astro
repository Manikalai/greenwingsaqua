---
import { Mail, MapPin, MessageCircle, Navigation, Phone, Star } from 'lucide-react';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import EnquiryForm from '@/components/EnquiryForm';
import { SITE, telHref, waHref } from '@/data/site';

const ways = [
  { icon: Phone, label: 'Call us', value: SITE.call.display, href: telHref, tone: 'from-brand-500 to-brand-600' },
  { icon: MessageCircle, label: 'WhatsApp', value: SITE.whatsapp.display, href: waHref("Hi, I'd like to enquire about a water purifier"), tone: 'from-emerald-400 to-emerald-600', external: true },
  { icon: Mail, label: 'Email', value: SITE.email, href: `mailto:${SITE.email}`, tone: 'from-aqua-400 to-aqua-600' },
];
---
<Base
  title="Contact Us — Green Wings Aqua, Sivaganga"
  description="Contact Green Wings Aqua Sales and Service in Sivaganga — call, WhatsApp or send an enquiry for water purifier sales, repair and AMC.">
  <PageHero eyebrow="Contact" title="Let's get your water sorted"
    text="Have a question or need a service visit? Call, WhatsApp, or send an enquiry and we'll call you back." />

  <section class="container-x pt-2">
    <div class="grid gap-4 sm:grid-cols-3">
      {ways.map((w, i) => (
        <a href={w.href} target={w.external ? '_blank' : undefined} rel={w.external ? 'noopener' : undefined}
          class="card group flex items-center gap-4" data-reveal style={`--delay:${i * 80}ms`}>
          <span class={`grid size-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br ${w.tone} text-white shadow-lg`}><w.icon className="size-5" /></span>
          <span class="min-w-0">
            <span class="block text-sm text-ink-500">{w.label}</span>
            <span class="block truncate font-display text-lg font-bold text-ink-900 group-hover:text-brand-700">{w.value}</span>
          </span>
        </a>
      ))}
    </div>

    <!-- Enquiry first on a phone: it is what most visitors came to do. -->
    <div class="mt-10 grid gap-8 lg:grid-cols-[1.15fr_1fr]">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl shadow-brand-900/5 sm:p-8" data-reveal>
        <h2 class="text-2xl font-extrabold">Send an enquiry</h2>
        <p class="mt-1.5 text-ink-600">Takes a minute — no account or sign-up needed.</p>
        <div class="relative mt-6"><EnquiryForm client:load waNumber={SITE.whatsapp.number} /></div>
      </div>

      <div class="grid content-start gap-6" data-reveal style="--delay:120ms">
        <div class="overflow-hidden rounded-[2rem] border border-slate-200 shadow-sm">
          <iframe src={SITE.mapEmbed} title="Green Wings Aqua location map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            class="aspect-[4/3] w-full border-0"></iframe>
        </div>
        <div class="rounded-[2rem] bg-gradient-to-br from-brand-50 to-aqua-50 p-6">
          <div class="flex gap-4">
            <span class="icon-tile shrink-0 bg-white"><MapPin className="size-6" /></span>
            <div>
              <h3 class="font-bold">Visit our shop</h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-600">{SITE.address.lines.map((l) => <>{l}<br /></>)}</p>
              <a href={SITE.mapLink} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:underline">
                <Navigation className="size-4" />Get directions
              </a>
            </div>
          </div>
          <div class="mt-5 flex items-center gap-2 border-t border-brand-100 pt-5 text-sm text-ink-600">
            <span class="flex text-amber-400">{[0, 1, 2, 3, 4].map(() => <Star className="size-4 fill-current" />)}</span>
            <span><b class="text-ink-900">{SITE.rating.value}</b> rating from {SITE.rating.count} Google reviews</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
