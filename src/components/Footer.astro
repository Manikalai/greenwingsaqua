---
import { Mail, MapPin, MessageCircle, Phone } from 'lucide-react';
import Wave from './Wave.astro';
import { NAV, SITE, telHref, waHref } from '@/data/site';

const socials = [
  { href: SITE.social.instagram, label: 'Instagram',
    path: 'M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zM12 5.8a6.2 6.2 0 1 0 0 12.4A6.2 6.2 0 0 0 12 5.8zm0 10.2a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8z' },
  { href: SITE.social.facebook, label: 'Facebook',
    path: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z' },
  { href: SITE.social.youtube, label: 'YouTube',
    path: 'M23 7.5s-.2-1.6-.9-2.3c-.9-.9-1.8-.9-2.3-1C17 4 12 4 12 4s-5 0-7.8.2c-.4 0-1.4.1-2.3 1C1.2 5.9 1 7.5 1 7.5S.8 9.4.8 11.3v1.4c0 1.9.2 3.8.2 3.8s.2 1.6.9 2.3c.9.9 2 .9 2.5 1 1.8.2 7.6.2 7.6.2s5 0 7.8-.2c.5-.1 1.4-.1 2.3-1 .7-.7.9-2.3.9-2.3s.2-1.9.2-3.8v-1.4c0-1.9-.2-3.8-.2-3.8zM9.8 15.1V9l6.4 3.1-6.4 3z' },
];
---
<footer class="relative mt-24 text-white">
  <Wave class="h-16 text-ink-900 sm:h-24" />
  <div class="bg-ink-900 pb-28 pt-6 lg:pb-12">
    <div class="container-x grid gap-10 md:grid-cols-[1.4fr_1fr_1.2fr]">
      <div>
        <div class="flex items-center gap-2.5">
          <img src="/assets/logo.png" alt="" width="44" height="32" class="h-9 w-auto rounded-md bg-white p-1" />
          <span class="font-display text-lg font-bold text-white">{SITE.legalName}</span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-300">
          Water purifier sales, installation, repair and AMC plans for homes and offices across Sivagangai district.
        </p>
        <div class="mt-5 flex gap-2">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={`${SITE.name} on ${s.label}`} title={s.label}
              class="grid size-10 place-items-center rounded-full bg-white/10 text-white transition hover:bg-brand-500">
              <svg viewBox="0 0 24 24" class="size-[18px]" aria-hidden="true"><path fill="currentColor" d={s.path} /></svg>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-aqua-300">Explore</h4>
        <ul class="mt-4 grid gap-2.5 text-sm">
          {NAV.map((n) => <li><a href={n.href} class="text-slate-300 transition hover:text-white">{n.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-aqua-300">Contact</h4>
        <ul class="mt-4 grid gap-3 text-sm text-slate-300">
          <li class="flex gap-3"><MapPin className="mt-0.5 size-4 shrink-0 text-aqua-300" /><span>{SITE.address.lines.join(' ')}</span></li>
          <li><a href={telHref} class="flex gap-3 hover:text-white"><Phone className="size-4 text-aqua-300" />Call {SITE.call.display}</a></li>
          <li><a href={waHref()} target="_blank" rel="noopener" class="flex gap-3 hover:text-white"><MessageCircle className="size-4 text-aqua-300" />WhatsApp {SITE.whatsapp.display}</a></li>
          <li><a href={`mailto:${SITE.email}`} class="flex gap-3 hover:text-white"><Mail className="size-4 text-aqua-300" />{SITE.email}</a></li>
        </ul>
      </div>
    </div>
    <div class="container-x mt-12 flex flex-wrap justify-between gap-3 border-t border-white/10 pt-6 text-xs text-slate-400">
      <span>© {new Date().getFullYear()} {SITE.legalName}. All rights reserved.</span>
      <span>greenwingsaqua.com</span>
    </div>
  </div>
</footer>
