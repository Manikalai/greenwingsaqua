---
import { Menu, MessageCircle, Phone, X } from 'lucide-react';
import { NAV, SITE, telHref, waHref } from '@/data/site';

const path = Astro.url.pathname.replace(/\/index(\.html)?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href.replace('.html', '')));
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="container-x">
    <nav class="mt-3 flex items-center justify-between gap-4 rounded-full px-3 py-2 transition-all duration-300 sm:px-4" id="nav-bar">
      <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
        <img src="/assets/logo.png" alt="" width="44" height="32" class="h-8 w-auto" />
        <span class="font-display text-[17px] font-bold tracking-tight text-ink-900">Green Wings <span class="text-brand-600">Aqua</span></span>
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {NAV.map((n) => (
          <li>
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}
              class:list={['rounded-full px-4 py-2 text-sm font-medium transition-colors',
                isActive(n.href) ? 'bg-brand-50 text-brand-700' : 'text-ink-600 hover:text-brand-700']}>
              {n.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="hidden items-center gap-2 lg:flex">
        <a href={telHref} class="btn-ghost !px-4 !py-2 text-sm"><Phone className="size-4" />{SITE.call.display}</a>
        <a href={waHref("Hi, I'm interested in Aqua purifier sales/service")} target="_blank" rel="noopener" class="btn-whatsapp !px-4 !py-2 text-sm">
          <MessageCircle className="size-4" />WhatsApp
        </a>
      </div>

      <button id="menu-toggle" type="button" class="grid size-10 place-items-center rounded-full text-ink-900 hover:bg-brand-50 lg:hidden"
        aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <Menu className="size-6 menu-open" /><X className="size-6 menu-close hidden" />
      </button>
    </nav>

    <div id="mobile-menu" class="glass mt-2 hidden rounded-3xl p-3 lg:hidden">
      <ul class="grid gap-1">
        {NAV.map((n) => (
          <li>
            <a href={n.href} class:list={['block rounded-2xl px-4 py-3 text-base font-medium',
              isActive(n.href) ? 'bg-brand-50 text-brand-700' : 'text-ink-800 hover:bg-brand-50']}>{n.label}</a>
          </li>
        ))}
      </ul>
      <div class="mt-3 grid grid-cols-2 gap-2">
        <a href={telHref} class="btn-ghost"><Phone className="size-4" />Call</a>
        <a href={waHref("Hi, I'm interested in Aqua purifier sales/service")} target="_blank" rel="noopener" class="btn-whatsapp"><MessageCircle className="size-4" />WhatsApp</a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('nav-bar');
  const onScroll = () => {
    const scrolled = window.scrollY > 12;
    header?.classList.toggle('glass', scrolled);
    header?.classList.toggle('shadow-lg', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('.menu-open')?.classList.toggle('hidden', open);
    btn.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  });
</script>
